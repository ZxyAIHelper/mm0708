@import "../../styles/theme.wxss";

page {
  background: var(--color-bg-primary);
}

.container {
  min-height: 100vh;
  padding: var(--spacing-xl);
  padding-bottom: 240rpx;
}

/* Progress Bar */
.progress-bar {
  margin-bottom: var(--spacing-lg);
}

.progress-text {
  font-size: var(--font-size-sm);
  color: var(--color-accent);
  font-weight: 600;
}

/* Header Section */
.header-section {
  margin-bottom: var(--spacing-3xl);
}

.page-title {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: var(--spacing-xs);
}

.page-subtitle {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  display: block;
}

/* Mode Selection - Radio Cards */
.mode-selection {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-lg);
  margin-bottom: var(--spacing-3xl);
}

.radio-card {
  padding: var(--spacing-lg);
  background: var(--color-bg-secondary);
  border: 2rpx solid var(--color-border-light);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  transition: all var(--transition-smooth);
}

.radio-card.active {
  border-color: var(--color-accent);
  background: rgba(212, 165, 116, 0.05);
}

.radio-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.radio-icon.couple {
  background: rgba(255, 82, 82, 0.1);
}

.radio-icon.child {
  background: rgba(33, 150, 243, 0.1);
}

.icon-emoji {
  font-size: 48rpx;
}

.radio-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.radio-title {
  font-size: var(--font-size-base);
  font-weight: 600;
  color: var(--color-text-primary);
}

.radio-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.radio-indicator {
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid var(--color-border-light);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.radio-indicator.checked {
  border-color: var(--color-accent);
}

.radio-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: transparent;
  transition: all var(--transition-smooth);
}

.radio-indicator.checked .radio-dot {
  background: var(--color-accent);
}

/* Form Section */
.form-section {
  margin-bottom: var(--spacing-2xl);
}

.form-row {
  display: flex;
  gap: var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
}

.form-group {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
}

.form-group.full {
  width: 100%;
}

.form-label {
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-left: 8rpx;
}

.form-input {
  height: 112rpx;
  padding: var(--spacing-md) var(--spacing-lg);
  background: var(--color-bg-secondary);
  border: 2rpx solid var(--color-border-light);
  border-radius: 24rpx;
  font-size: 36rpx;
  color: var(--color-text-primary);
}

.form-input:focus {
  border-color: var(--color-accent);
  box-shadow: 0 0 0 4rpx rgba(212, 165, 116, 0.1);
}

.form-hint {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  text-align: right;
  margin-right: 8rpx;
}

/* Info Box */
.info-box {
  padding: var(--spacing-md);
  background: rgba(255, 193, 7, 0.08);
  border-radius: 16rpx;
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-sm);
}

.info-icon {
  font-size: 28rpx;
  margin-top: 2rpx;
}

.info-text {
  flex: 1;
  font-size: 24rpx;
  color: rgba(230, 126, 34, 0.9);
  line-height: 1.5;
}

/* Bottom Button */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--spacing-lg) var(--spacing-xl);
  padding-bottom: calc(var(--spacing-lg) + env(safe-area-inset-bottom));
  background: linear-gradient(to top, var(--color-bg-primary), transparent);
}

.generate-btn {
  width: 100%;
  height: 112rpx;
  background: var(--color-accent);
  color: #ffffff;
  border-radius: 32rpx;
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-sm);
  box-shadow: 0 16rpx 32rpx rgba(212, 165, 116, 0.3);
  transition: all var(--transition-smooth);
}

.generate-btn:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 16rpx rgba(212, 165, 116, 0.3);
}

.generate-btn[disabled] {
  opacity: 0.5;
}

.btn-icon {
  font-size: 40rpx;
}

/* Loading Overlay */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loading-animation {
  background: var(--color-bg-secondary);
  padding: var(--spacing-3xl);
  border-radius: 32rpx;
  text-align: center;
}

.loading-text {
  font-size: var(--font-size-lg);
  color: var(--color-text-primary);
  white-space: pre-line;
}
