@import "../../styles/theme.wxss";

page {
  background: var(--color-bg-primary);
}

.container {
  min-height: 100vh;
  padding: var(--spacing-2xl) var(--spacing-lg);
  padding-bottom: 120rpx;
}

/* Couplet Display Section */
.couplet-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: var(--spacing-4xl);
}

/* Banner Scroll (Horizontal) */
.banner-scroll {
  margin-bottom: var(--spacing-3xl);
}

.scroll-paper {
  background: linear-gradient(135deg, #D32F2F 0%, #C62828 100%);
  box-shadow: 0 16rpx 32rpx rgba(211, 47, 47, 0.3);
  position: relative;
  overflow: hidden;
}

.scroll-paper::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: 
    radial-gradient(circle at 20% 30%, rgba(255, 255, 255, 0.1) 1px, transparent 1px),
    radial-gradient(circle at 80% 70%, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
  background-size: 40rpx 40rpx;
  opacity: 0.3;
  pointer-events: none;
}

.scroll-paper.horizontal {
  padding: 32rpx 64rpx;
  border-radius: 16rpx;
}

.banner-text {
  font-size: 56rpx;
  font-weight: 700;
  color: #FFD54F;
  letter-spacing: 32rpx;
  text-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.3);
  position: relative;
  z-index: 1;
}

/* Vertical Scrolls Container */
.scrolls-container {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: var(--spacing-xl);
  max-width: 600rpx;
}

.scroll-paper.vertical {
  padding: 48rpx 32rpx;
  border-radius: 16rpx;
  min-height: 600rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.vertical-text {
  writing-mode: vertical-rl;
  text-orientation: upright;
}

.couplet-text {
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 24rpx;
  line-height: 1.6;
  position: relative;
  z-index: 1;
  /* Calligraphy font stack - use system calligraphy fonts */
  font-family: "STKaiti", "KaiTi", "楷体", "SimKai", serif;
}

/* Individual character styling */
.couplet-text .char {
  color: #000000; /* Default black */
  text-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

/* Highlighted characters (input names) */
.couplet-text .char.highlight {
  color: #FFD54F; /* Golden yellow for highlighted characters */
}

.banner-text {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 32rpx;
  position: relative;
  z-index: 1;
  font-family: "STKaiti", "KaiTi", "楷体", "SimKai", serif;
}

.banner-text .char {
  color: #000000;
  text-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.banner-text .char.highlight {
  color: #FFD54F;
}

/* Center Decoration */
.center-decoration {
  padding-top: 160rpx;
  opacity: 0.15;
}

.decoration-icon {
  font-size: 120rpx;
  color: var(--color-accent);
}

/* Explanation Section */
.explanation-section {
  margin-bottom: var(--spacing-3xl);
  animation: fadeInUp 0.6s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.section-header {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-lg);
}

.header-line {
  width: 8rpx;
  height: 48rpx;
  background: var(--color-accent);
  border-radius: 4rpx;
}

.section-title {
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--color-text-primary);
}

.explanation-card {
  padding: var(--spacing-xl);
  background: var(--color-bg-secondary);
  border: 1rpx solid var(--color-border-light);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.explanation-text {
  font-size: var(--font-size-sm);
  line-height: 1.8;
  color: var(--color-text-secondary);
  display: block;
}

/* Action Buttons */
.action-buttons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--spacing-lg);
  margin-bottom: var(--spacing-xl);
}

.action-btn {
  height: 96rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xs);
  font-size: var(--font-size-base);
  font-weight: 600;
  transition: all var(--transition-smooth);
}

.action-btn.secondary {
  background: transparent;
  border: 2rpx solid var(--color-accent);
  color: var(--color-accent);
}

.action-btn.secondary:active {
  background: rgba(212, 165, 116, 0.05);
}

.action-btn.primary {
  background: var(--color-accent);
  color: #ffffff;
  box-shadow: 0 16rpx 32rpx rgba(212, 165, 116, 0.3);
}

.action-btn.primary:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 16rpx rgba(212, 165, 116, 0.3);
}

.btn-icon {
  font-size: 32rpx;
}

/* Regenerate Section */
.regenerate-section {
  text-align: center;
}

.regenerate-btn {
  background: transparent;
  color: var(--color-text-tertiary);
  font-size: var(--font-size-sm);
  padding: 0;
  border: none;
  line-height: 1;
}

.regenerate-btn:active {
  color: var(--color-text-secondary);
}

.regenerate-btn::after {
  border: none;
}
