@import "../../styles/theme.wxss";

page {
  background: var(--color-bg-primary);
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: var(--spacing-3xl) var(--spacing-xl);
  padding-bottom: 180rpx; /* Space for tab bar */
}

/* Hero Section */
.hero {
  text-align: center;
  margin-bottom: var(--spacing-4xl);
  margin-top: var(--spacing-4xl);
}

.icon-circle {
  width: 128rpx;
  height: 128rpx;
  background: rgba(211, 47, 47, 0.08);
  border-radius: 50%;
  border: 2rpx solid rgba(211, 47, 47, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto var(--spacing-lg);
}

.icon-text {
  font-size: 64rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-sm);
  letter-spacing: var(--letter-spacing-normal);
}

.hero-subtitle {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  letter-spacing: var(--letter-spacing-wide);
}

/* Cards Container */
.cards-container {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xl);
  max-width: 600rpx;
  margin: 0 auto;
  width: 100%;
}

/* Footer */
.footer {
  margin-top: auto;
  padding-top: var(--spacing-4xl);
  padding-bottom: var(--spacing-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-md);
}

.footer-divider {
  width: 60rpx;
  height: 1rpx;
  background: #e0d8d0;
}

.footer-text {
  font-size: 22rpx;
  color: #d0c8c0;
  letter-spacing: 4rpx;
  font-style: italic;
  font-weight: 300;
}
