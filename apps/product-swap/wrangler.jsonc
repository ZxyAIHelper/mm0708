{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "product-swap",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-17",
  "routes": [
    {
      "pattern": "product-swap.mm0708.top",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
